# Saleor GraphQL API
SALEOR_API_URL=http://localhost:8000/graphql/

# URL pública de esta app
APP_API_BASE_URL=http://localhost:3002/

# APL — "env" = single tenant vía variable de entorno
APL=env

# Verbosidad del log: fatal | error | warn | info | debug | trace | silent.
# Default: info. Un valor inválido cae a info y lo avisa en el arranque.
LOG_LEVEL=info

# Obtener tras instalar la app en el Dashboard de Saleor:
SALEOR_APP_TOKEN=
SALEOR_APP_ID=

# (Opcional) Envío gratis TEMPORAL para compras de prueba (B-2451). ISO 8601 CON zona horaria,
# p. ej. 2026-11-27T06:00:00-05:00. Mientras ahora < esta fecha, el webhook de envíos añade
# el método «Envío gratis (temporal)» además de los tres de siempre. Vacía/ausente/inválida/vencida
# = comportamiento normal. Si la fecha está a más de 72 h, se ignora (salvaguarda) y se avisa en log.
# Saleor guarda los métodos por checkout (24 h): tras caducar, usar un checkout nuevo.
ENVIO_GRATIS_HASTA=
