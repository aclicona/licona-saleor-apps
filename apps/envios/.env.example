# Saleor GraphQL API
SALEOR_API_URL=http://localhost:8000/graphql/

# URL pública de esta app
APP_API_BASE_URL=http://localhost:3002/

# APL — "env" = single tenant vía variable de entorno
APL=env

# Verbosidad del log: fatal | error | warn | info | debug | trace | silent.
# Default: info. Un valor inválido cae a info y lo avisa en el arranque.
LOG_LEVEL=info

# Obtener tras instalar la app en el Dashboard de Saleor:
SALEOR_APP_TOKEN=
SALEOR_APP_ID=
