# Saleor GraphQL API
SALEOR_API_URL=http://localhost:8000/graphql/

# URL pública de esta app (Saleor llama a este host para los webhooks)
# Local: usar ngrok o similar si el Dashboard está en Railway
# Local-to-local: http://localhost:3001
APP_API_BASE_URL=http://localhost:3001/

# APL — "env" = single tenant vía variable de entorno
APL=env

# Obtener tras instalar la app en el Dashboard de Saleor:
# Dashboard → Apps → Install → http://localhost:3001/api/manifest
SALEOR_APP_TOKEN=
SALEOR_APP_ID=

# Credenciales sandbox Wompi — https://developers.wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
